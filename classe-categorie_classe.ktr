  <step>
    <name>Extraction depuis table categorie classe</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>sco</connection>
    <sql>SELECT 
    CASE 
        WHEN CODE_CL LIKE '5 ERP-BI%' THEN '5 ERP-BI' 
        WHEN CODE_CL LIKE '4 ERP-BI%' THEN '4 ERP-BI' 
        WHEN CODE_CL LIKE '1ALINFO%' THEN '1ALINFO'
        WHEN CODE_CL LIKE '2ALINFO%' THEN '2ALINFO'
        WHEN CODE_CL LIKE '2A%' THEN '2A'
        WHEN CODE_CL LIKE '3A%' THEN '3A'
        WHEN CODE_CL LIKE '3B%' THEN '3B'
        WHEN CODE_CL LIKE '4ARCTIC%' THEN '4ARCTIC'
        WHEN CODE_CL LIKE '5ARCTIC%' THEN '5ARCTIC'
        ELSE 'Autre' 
    END AS CODE_CL
FROM 
    fakhri.example_table
GROUP BY 
    CASE 
        WHEN CODE_CL LIKE '5 ERP-BI%' THEN '5 ERP-BI' 
        WHEN CODE_CL LIKE '4 ERP-BI%' THEN '4 ERP-BI' 
        WHEN CODE_CL LIKE '1ALINFO%' THEN '1ALINFO'
        WHEN CODE_CL LIKE '2ALINFO%' THEN '2ALINFO'
        WHEN CODE_CL LIKE '2A%' THEN '2A'
        WHEN CODE_CL LIKE '3A%' THEN '3A'
        WHEN CODE_CL LIKE '3B%' THEN '3B'
        WHEN CODE_CL LIKE '4ARCTIC%' THEN '4ARCTIC'
        WHEN CODE_CL LIKE '5ARCTIC%' THEN '5ARCTIC'
        ELSE 'Autre' 
    END
ORDER BY 
    CODE_CL;</sql>
