        <jsScript_script>//Composez votre script java dans l'espace ci-dessous

// Initialiser id_categorie_classe
var id_categorie_classe;

// Créer un tableau associatif pour mapper lib_classe aux id_categorie_classe
var categorieMap = {
    '1ALINFO': 131,
    '2ALINFO': 132,
    '2A': 133,
    '3A': 134,
    '3B': 135,
    '4ARCTIC': 136,
    '5ARCTIC': 137,
    '4 ERP-BI': 138,
    '5 ERP-BI': 139
};

// Vérifier chaque préfixe dans CODE_CL
for (var prefix in categorieMap) {
    if (CODE_CL.indexOf(prefix) === 0) {
        id_categorie_classe = categorieMap[prefix]; // Assigner la valeur correspondante
        break; // Sortir de la boucle dès qu'une correspondance est trouvée
    }
}

// Si aucune correspondance, définir comme null ou une autre valeur par défaut
if (id_categorie_classe === undefined) {
    id_categorie_classe = null; // Ou une autre valeur par défaut
}

// Maintenant, id_categorie_classe peut être utilisé pour l'insertion ou d'autres opérationsse peut être utilisé pour l'insertion ou d'autres opérationsutiliser id_categorie_classe pour l'insertion ou d'autres opérationss pouvez utiliser id_niveau pour l'insertion ou d'autres opérations</jsScript_script>
