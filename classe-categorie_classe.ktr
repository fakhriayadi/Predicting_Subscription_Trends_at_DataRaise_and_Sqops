        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Composez votre script java dans l'espace ci-dessous

// Initialiser id_niveau
var id_niveau;

// Déterminer la valeur de id_niveau en fonction de CODE_CL
if (CODE_CL.indexOf('1') === 0) {
    id_niveau_new = 1;
} else if (CODE_CL.indexOf('2') === 0) {
    id_niveau_new = 2;
} else if (CODE_CL.indexOf('3') === 0) {
    id_niveau_new = 3;
} else if (CODE_CL.indexOf('4') === 0) {
    id_niveau_new = 4;
} else if (CODE_CL.indexOf('5') === 0) {
    id_niveau_new = 5;
} else {
    id_niveau_new = null; // Valeur par défaut si aucune condition ne correspond
}

// Maintenant, vous pouvez utiliser id_niveau pour l'insertion ou d'autres opérations</jsScript_script>
